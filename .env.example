VITE_API_BASE_URL=http://localhost:8000
BLANK_BACKEND_HOST=127.0.0.1
BLANK_FRONTEND_HOST=127.0.0.1
BLANK_ALLOWED_HOSTS=localhost,127.0.0.1
BLANK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BLANK_ADMIN_BOOTSTRAP_KEY=change-this-before-first-admin
BLANK_SECRET_KEY=change-this-to-at-least-32-random-characters
BLANK_MAX_REQUEST_BYTES=1048576
BLANK_MODEL_CONNECT_TIMEOUT=12
BLANK_MODEL_READ_TIMEOUT=90
BLANK_SLOW_MODEL_READ_TIMEOUT=240
BLANK_DEBUG_LOG_ENABLED=true
BLANK_DEBUG_LOG_PATH=backend/data/debug.log
BLANK_DEBUG_LOG_CONSOLE=true
BLANK_DEBUG_LOG_ROTATE_WHEN=midnight
BLANK_DEBUG_LOG_ROTATE_INTERVAL=1
BLANK_DEBUG_LOG_MAX_BYTES=10485760
BLANK_DEBUG_LOG_BACKUP_COUNT=14
BLANK_ALLOW_PRIVATE_MODEL_URLS=false
BLANK_TRUST_PROXY_HEADERS=false
BLANK_ALLOW_PUBLIC_REGISTRATION=false
# PostgreSQL 是默认主存储；开发环境也需要显式可用的 PostgreSQL 服务。
BLANK_DATABASE_URL=postgresql://blank:blank@127.0.0.1:5432/blank
# Redis 是默认限流后端；仅测试环境或显式 BLANK_ALLOW_IN_MEMORY_RATE_LIMIT=true 才允许内存回退。
BLANK_REDIS_URL=redis://127.0.0.1:6379/0

# Neo4j 图数据库配置（GraphRAG 数据底座）
BLANK_GRAPHRAG_ENABLED=true
BLANK_NEO4J_URI=bolt://127.0.0.1:7687
BLANK_NEO4J_USER=neo4j
BLANK_NEO4J_PASSWORD=change-this-password
# BLANK_EMBEDDING_DIM=1536          # Embedding 向量维度（OpenAI 默认 1536，Ollama 常用 768）
# BLANK_EMBEDDING_SIMILARITY=cosine # 向量相似度函数（cosine / euclidean）
