BLANK_ENV=production
BLANK_SECRET_KEY=replace-with-at-least-32-random-characters
BLANK_TOKEN_HASH_KEY=replace-with-separate-32-random-characters
BLANK_ADMIN_BOOTSTRAP_KEY=replace-before-first-admin-registration
BLANK_ALLOWED_HOSTS=blank.example.com
BLANK_CORS_ORIGINS=https://blank.example.com
BLANK_DATABASE_URL=postgresql://blank:replace-password@127.0.0.1:5432/blank
BLANK_REDIS_URL=redis://127.0.0.1:6379/0
BLANK_SECURITY_LOG_PATH=/var/log/blank/security.log
BLANK_DEBUG_LOG_ENABLED=true
BLANK_DEBUG_LOG_PATH=/var/log/blank/debug.log
BLANK_DEBUG_LOG_CONSOLE=false
BLANK_DEBUG_LOG_ROTATE_WHEN=midnight
BLANK_DEBUG_LOG_ROTATE_INTERVAL=1
BLANK_DEBUG_LOG_MAX_BYTES=10485760
BLANK_DEBUG_LOG_BACKUP_COUNT=14
BLANK_MAX_REQUEST_BYTES=1048576
BLANK_MODEL_CONNECT_TIMEOUT=12
BLANK_MODEL_READ_TIMEOUT=90
BLANK_SLOW_MODEL_READ_TIMEOUT=240
BLANK_ALLOW_PRIVATE_MODEL_URLS=false
BLANK_TRUST_PROXY_HEADERS=true
BLANK_TRUSTED_PROXIES=127.0.0.1/32
BLANK_ALLOW_PUBLIC_REGISTRATION=false
BLANK_COOKIE_SECURE=true
BLANK_COOKIE_SAMESITE=strict
BLANK_GRAPHRAG_ENABLED=true
BLANK_NEO4J_URI=bolt://127.0.0.1:7687
BLANK_NEO4J_USER=neo4j
BLANK_NEO4J_PASSWORD=replace-with-strong-neo4j-password
